import requests
import json
import os
from typing import Dict, Any, Optional
from langfuse import Langfuse
from langfuse.api import UpdateGenerationRequest

class FlowiseAgentFlowManager:
    def __init__(self, flowise_base_url: str = "http://localhost:3000"):
        self.base_url = flowise_base_url
        self.api_key = os.getenv("FLOWISE_API_KEY")
        self.langfuse = Langfuse(
            secret_key=os.getenv("LANGFUSE_SECRET_KEY"),
            public_key=os.getenv("LANGFUSE_PUBLIC_KEY"),
            host=os.getenv("LANGFUSE_BASE_URL", "https://us.cloud.langfuse.com")
        )
    
    def create_agentflow_json(self, name: str, description: str) -> Dict[str, Any]:
        """
        Creates the JSON structure for an AgentFlow with proper Langfuse tracking
        """
        flow_data = {
            "name": name,
            "description": description,
            "type": "AGENTFLOW",  # or "CHATFLOW"
            "data": {
                "nodes": [
                    {
                        "id": "start-node-001",
                        "type": "startNode",
                        "position": {"x": 100, "y": 100},
                        "data": {
                            "id": "start-node-001",
                            "node": {
                                "name": "Start",
                                "inputType": "chatInput",
                                "flowState": [
                                    {"key": "query", "value": ""},
                                    {"key": "response", "value": ""},
                                    {"key": "token_usage", "value": {}}
                                ]
                            },
                            "type": "startNode"
                        }
                    },
                    {
                        "id": "agent-node-001",
                        "type": "agentNode", 
                        "position": {"x": 400, "y": 100},
                        "data": {
                            "id": "agent-node-001",
                            "node": {
                                "name": "Main Agent",
                                "systemMessage": "You are a helpful assistant.",
                                "model": "gpt-4o",
                                "temperature": 0.7,
                                "streaming": False,  # CRITICAL: Disable streaming for token tracking
                                "updateFlowState": {
                                    "response": "{{ output }}"
                                },
                                # Add Langfuse metadata injection
                                "metadata": {
                                    "langfuse_trace": True,
                                    "track_tokens": True
                                }
                            },
                            "type": "agentNode"
                        }
                    },
                    {
                        "id": "end-node-001",
                        "type": "endNode",
                        "position": {"x": 700, "y": 100},
                        "data": {
                            "id": "end-node-001",
                            "node": {
                                "name": "End",
                                "message": "{{ agent-node-001.output }}"
                            },
                            "type": "endNode"
                        }
                    }
                ],
                "edges": [
                    {
                        "id": "edge-start-agent",
                        "source": "start-node-001",
                        "target": "agent-node-001",
                        "type": "buttonedge"
                    },
                    {
                        "id": "edge-agent-end",
                        "source": "agent-node-001", 
                        "target": "end-node-001",
                        "type": "buttonedge"
                    }
                ],
                "viewport": {
                    "x": 0,
                    "y": 0,
                    "zoom": 1
                }
            }
        }
        return flow_data

    def import_flow(self, flow_json: Dict[str, Any]) -> Optional[str]:
        """
        Import flow to Flowise via API
        """
        url = f"{self.base_url}/api/v1/export-import/import"
        
        headers = {
            "Content-Type": "application/json"
        }
        
        if self.api_key:
            headers["Authorization"] = f"Bearer {self.api_key}"
        
        try:
            response = requests.post(url, json=flow_json, headers=headers)
            response.raise_for_status()
            result = response.json()
            print(f"✅ Flow imported successfully: {result}")
            return result.get("id")
        except requests.exceptions.RequestException as e:
            print(f"❌ Failed to import flow: {e}")
            if hasattr(e.response, 'text'):
                print(f"Response: {e.response.text}")
            return None

    def execute_flow(self, flow_id: str, question: str, session_id: Optional[str] = None) -> Dict[str, Any]:
        """
        Execute the flow and capture response with manual token tracking
        """
        url = f"{self.base_url}/api/v1/prediction/{flow_id}"
        
        payload = {
            "question": question,
            "streaming": False,  # Ensure non-streaming for token tracking
            "overrideConfig": {
                "analytics": {
                    "langfuse": {
                        "trace": True,
                        "track_tokens": True
                    }
                }
            }
        }
        
        if session_id:
            payload["overrideConfig"]["sessionId"] = session_id
        
        headers = {
            "Content-Type": "application/json"
        }
        
        if self.api_key:
            headers["Authorization"] = f"Bearer {self.api_key}"
        
        try:
            response = requests.post(url, json=payload, headers=headers)
            response.raise_for_status()
            result = response.json()
            
            # Manually extract token usage if available in response
            self._process_token_usage(result, flow_id, question)
            
            return result
        except requests.exceptions.RequestException as e:
            print(f"❌ Flow execution failed: {e}")
            return {}

    def _process_token_usage(self, result: Dict, flow_id: str, question: str):
        """
        Extract and manually push token usage to Langfuse if not captured automatically
        """
        # Look for usage metadata in the response
        usage = result.get("usage") or result.get("tokenUsage") or {}
        
        if usage:
            prompt_tokens = usage.get("prompt_tokens", 0)
            completion_tokens = usage.get("completion_tokens", 0)
            total_tokens = usage.get("total_tokens", prompt_tokens + completion_tokens)
            model = result.get("model", "unknown")
            
            # Create a trace with proper token counts
            trace = self.langfuse.trace(
                name="agentflow_execution",
                input=question,
                output=result.get("text", ""),
                metadata={
                    "flow_id": flow_id,
                    "model": model
                }
            )
            
            # Add generation with token counts
            trace.generation(
                name="llm_call",
                model=model,
                input=question,
                output=result.get("text", ""),
                usage={
                    "input": prompt_tokens,
                    "output": completion_tokens,
                    "total": total_tokens,
                    "unit": "TOKENS"
                }
            )
            
            self.langfuse.flush()
            print(f"📊 Manually tracked tokens: {total_tokens} (Prompt: {prompt_tokens}, Completion: {completion_tokens})")

    def update_langfuse_generation(self, generation_id: str, token_usage: Dict[str, int]):
        """
        Update an existing Langfuse generation with token usage (upsert within 60 days)
        """
        try:
            update_data = UpdateGenerationRequest(
                usage={
                    "input": token_usage.get("input_tokens", 0),
                    "output": token_usage.get("output_tokens", 0),
                    "total": token_usage.get("total_tokens", 0),
                    "unit": "TOKENS"
                }
            )
            
            self.langfuse.api.generations.update(
                id=generation_id,
                body=update_data
            )
            print(f"✅ Updated generation {generation_id} with token usage")
        except Exception as e:
            print(f"❌ Failed to update generation: {e}")


# ===== USAGE EXAMPLE =====

if __name__ == "__main__":
    # Initialize manager
    manager = FlowiseAgentFlowManager("http://localhost:3000")
    
    # 1. Create flow JSON
    flow_json = manager.create_agentflow_json(
        name="TokenTrackingAgent",
        description="AgentFlow with manual token tracking fix"
    )
    
    # Save to file for inspection
    with open("agentflow.json", "w") as f:
        json.dump(flow_json, f, indent=2)
    print("💾 Flow JSON saved to agentflow.json")
    
    # 2. Import to Flowise (or use UI Import feature)
    # NOTE: Due to Flowise bug #5064, import may fail silently in v3.0.5+
    # Workaround: Create flow in UI, then update via API or use /chatflows endpoint
    
    # Alternative: Create via POST /chatflows
    flow_id = manager.import_flow(flow_json)
    
    if flow_id:
        # 3. Execute with manual token tracking
        result = manager.execute_flow(
            flow_id=flow_id,
            question="What is the capital of France?",
            session_id="test-session-001"
        )
        print("Result:", json.dumps(result, indent=2))
    
